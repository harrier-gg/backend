{
  "name": "@harrier-gg/discord",
  "version": "0.5.0",
  "private": true,
  "description": "Discord bot: slash commands and notifications (ADR 0014). Talks to Discord and NATS only",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@discordjs/core": "^2.7.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "@harrier-gg/contracts": "*",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/microservices": "^12.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
