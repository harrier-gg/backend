{
  "name": "@harrier-gg/gateway",
  "version": "0.2.0",
  "private": true,
  "description": "Single public entry point: REST for the web app, WebSocket for agents",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "openapi": "node dist/export-openapi.js ../../openapi.json"
  },
  "dependencies": {
    "@harrier-gg/contracts": "*",
    "@harrier-gg/protocol": "*",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/microservices": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.2"
  }
}
