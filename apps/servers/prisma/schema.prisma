// Data owned by the servers service. Other services never read these tables (ADR 0001).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["servers"]
}

/// A machine that runs an agent (ADR 0004).
model Node {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @unique
  /// SHA-256 of the token secret. The token itself is never stored.
  tokenHash  Bytes     @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  servers    Server[]

  @@map("nodes")
  @@schema("servers")
}

/// A game server on a node, created from a template (ADR 0005).
model Server {
  id            String   @id @default(uuid(7)) @db.Uuid
  nodeId        String   @map("node_id") @db.Uuid
  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  name          String
  templateId    String   @map("template_id")
  /// Validated values for the template's config fields.
  settings      Json
  /// Port players connect to on the node.
  hostPort      Int      @map("host_port")
  /// When the template's install script last finished (the server reached running); null = run it at the next start (ADR 0022).
  installedAt   DateTime? @map("installed_at")
  /// Last status reported by the agent.
  status        String   @default("stopped")
  statusMessage String?  @map("status_message")
  createdAt     DateTime @default(now()) @map("created_at")
  /// Backup schedule (ADR 0016): every N hours (0 = only by hand), keep the newest M.
  backupEveryHours  Int       @default(24) @map("backup_every_hours")
  backupKeep        Int       @default(7) @map("backup_keep")
  lastBackupAt      DateTime? @map("last_backup_at")
  /// Ran since its last backup; only such servers are due, so a stopped server does not
  /// replace older backups with copies of the same state.
  activeSinceBackup Boolean   @default(false) @map("active_since_backup")
  content           InstalledContent[]
  metrics       ServerMetric[]

  @@unique([nodeId, hostPort])
  @@unique([nodeId, name])
  @@map("servers")
  @@schema("servers")
}

/// One minute of a server's resource usage and players, kept for 7 days (ADR 0009).
model ServerMetric {
  serverId    String   @map("server_id") @db.Uuid
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  at          DateTime
  cpuPercent  Float    @map("cpu_percent") @db.Real
  memoryBytes BigInt   @map("memory_bytes")
  players     Int?

  @@id([serverId, at])
  @@index([at])
  @@map("server_metrics")
  @@schema("servers")
}

/// A mod, plugin or other content installed from a provider (ADR 0017).
model InstalledContent {
  id          String   @id @default(uuid(7)) @db.Uuid
  serverId    String   @map("server_id") @db.Uuid
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind        String
  provider    String
  projectId   String   @map("project_id")
  versionId   String   @map("version_id")
  name        String
  version     String
  /// Relative to the server's data directory.
  path        String
  sha512      String?
  sha1        String?
  /// Where the file came from, for sharing it with players (ADR 0018).
  url         String?
  size        Int?
  side        String?
  /// Installed because another project needs it, not picked by a user.
  dependency  Boolean  @default(false)
  /// Projects of the same provider this version needs; for cleaning up unused dependencies.
  requires    String[] @default([])
  installedAt DateTime @default(now()) @map("installed_at")

  @@unique([serverId, provider, projectId])
  @@map("installed_content")
  @@schema("servers")
}

/// The last good index from HARRIER_TEMPLATES_URL, so the panel starts without network (ADR 0021).
model TemplateCache {
  id        Int      @id @default(1)
  index     Json
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("template_cache")
  @@schema("servers")
}
