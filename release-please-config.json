{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "harrier-backend",
      "extra-files": [
        "apps/gateway/src/version.ts",
        "apps/servers/src/version.ts",
        {
          "type": "json",
          "path": "apps/gateway/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/servers/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "openapi.json",
          "jsonpath": "$.info.version"
        }
      ],
      "include-component-in-tag": false
    }
  }
}
